# Copy to backend/.env and adjust. Every setting in app/config.py can be set here.

# ---- input ----
LOG_FILE=../data/app.log
LOG_FORMAT=generic           # generic | bgl
TAIL_FROM_END=true

# ---- detection ----
WINDOW_SECONDS=60
TICK_SECONDS=5
BASELINE_WARMUP_TICKS=24
CRITICAL_ERROR_RATE=0.5
ALERT_COOLDOWN_SECONDS=60

# ---- demo: generate logs inside the backend (no second terminal needed) ----
SIMULATOR_ENABLED=false

# ---- AWS (CloudWatch Logs + SNS) ----
AWS_ENABLED=false
AWS_REGION=us-east-1
# Leave empty for real AWS; use http://localhost:4566 for LocalStack
AWS_ENDPOINT_URL=
CLOUDWATCH_LOG_GROUP=/log-anomaly-detector/alerts
CLOUDWATCH_LOG_STREAM=alerts
SNS_TOPIC_ARN=
SNS_MIN_SEVERITY=HIGH
# Credentials come from the normal AWS chain (env vars, ~/.aws, IAM role).
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
